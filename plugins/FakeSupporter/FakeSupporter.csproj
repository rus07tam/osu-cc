<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FakeSupporter</AssemblyName>
    <RootNamespace>FakeSupporter</RootNamespace>
    <IsPlugin>true</IsPlugin>
    <PluginId>fake-supporter</PluginId>
    <PluginName>Fake Supporter</PluginName>
    <PluginDescription>Fakes the current player's osu!supporter tag (level 1–10) everywhere, plus
      per-user supporter overrides and a public rule API.</PluginDescription>
    <PluginVersion>1.0.0</PluginVersion>
    <PluginIconGlyph>Heart</PluginIconGlyph>
  </PropertyGroup>

  <ItemGroup>
    <PluginAuthor Include="rus07tam" OsuProfileId="33701908" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="osucc.Host" />
    <PackageReference Include="osucc.Build" PrivateAssets="all" />
    <PackageReference Include="ppy.osu.Game" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localisation/*.json" />
  </ItemGroup>

</Project>
