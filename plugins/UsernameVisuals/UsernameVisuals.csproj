<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>UsernameVisuals</AssemblyName>
    <RootNamespace>UsernameVisuals</RootNamespace>
    <IsPlugin>true</IsPlugin>
    <PackageId>username-visuals</PackageId>
    <Title>Username Visuals</Title>
    <Description>Username visuals plus an own-username display override (custom text / hide).</Description>
    <Version>1.0.1</Version>
    <IconGlyph>FillDrip</IconGlyph>
    <RepositoryUrl>https://github.com/RuJect/osu-cc</RepositoryUrl>
    <PackageTags>profile;username;visual;library</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Author Include="rus07tam" OsuProfileId="33701908" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="osucc.Api" />
    <PackageReference Include="osucc.Build" PrivateAssets="all" />
    <PackageReference Include="ppy.osu.Game" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localisation/*.json" />
  </ItemGroup>

</Project>
