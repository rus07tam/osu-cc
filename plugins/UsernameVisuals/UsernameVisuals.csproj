<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>UsernameVisuals</AssemblyName>
    <RootNamespace>UsernameVisuals</RootNamespace>
    <IsPlugin>true</IsPlugin>
    <PluginId>username-visuals</PluginId>
    <PluginName>Username Visuals</PluginName>
    <PluginAuthor>osu-cc</PluginAuthor>
    <PluginDescription>Username visuals plus an own-username display override (custom text / hide).</PluginDescription>
    <PluginVersion>1.0.0</PluginVersion>
    <PluginIconGlyph>FillDrip</PluginIconGlyph>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="osucc.Host" />
    <PackageReference Include="osucc.Build" PrivateAssets="all" />
    <PackageReference Include="ppy.osu.Game" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localisation/*.json" />
  </ItemGroup>

</Project>
