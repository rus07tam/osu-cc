<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ExamplePlugin</AssemblyName>
    <RootNamespace>ExamplePlugin</RootNamespace>
    <IsPlugin>true</IsPlugin>
    <PackageId>example</PackageId>
    <Title>Example Plugin</Title>
    <Description>Demonstrates the osu!cc plugin API: toolbar button, notifications,
      celebrations, settings, a Harmony patch, lifecycle hooks and a data migration.</Description>
    <Version>1.0.1</Version>
    <Priority>100</Priority>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/RuJect/osu-cc</RepositoryUrl>
    <PackageTags>example;dev</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Author Include="rus07tam" OsuProfileId="33701908" />
  </ItemGroup>

  <ItemGroup>
    <PluginDependency Include="username-visuals" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="osucc.Api" />
    <PackageReference Include="osucc.Build" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" />
    <PackageReference Include="ppy.osu.Game" />
    <!-- Contract assembly of the built-in UsernameVisuals plugin, consumed as a demo of
         the plugin-to-plugin API (host.GetApi<IUsernameVisualsApi>). Not packed into the
         plugin archive: at runtime it resolves to the already-loaded plugin assembly. -->
    <ProjectReference Include="..\UsernameVisuals\UsernameVisuals.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localisation/*.json" />
  </ItemGroup>

</Project>
