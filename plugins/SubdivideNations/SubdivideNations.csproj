<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SubdivideNations</AssemblyName>
    <RootNamespace>SubdivideNations</RootNamespace>
    <IsPlugin>true</IsPlugin>
    <PluginId>subdivide-nations</PluginId>
    <PluginName>Subdivide Nations</PluginName>
    <PluginDescription>Shows each user's sub-national region on profiles and user cards.</PluginDescription>
    <PluginVersion>1.0.1</PluginVersion>
    <PluginIcon>icon.png</PluginIcon>
    <PluginRepository>https://github.com/RuJect/osu-cc</PluginRepository>
  </PropertyGroup>

  <ItemGroup>
    <PluginAuthor Include="rus07tam" OsuProfileId="33701908" />
    <PluginTag Include="profile" />
    <PluginTag Include="region" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="osucc.Host" />
    <PackageReference Include="osucc.Build" PrivateAssets="all" />
    <PackageReference Include="ppy.osu.Game" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Regions.json" />
    <EmbeddedResource Include="Localisation/*.json" />
  </ItemGroup>

</Project>
