<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CustomUserGroups</AssemblyName>
    <RootNamespace>CustomUserGroups</RootNamespace>
    <IsPlugin>true</IsPlugin>
    <PackageId>custom-user-groups</PackageId>
    <Title>Custom User Groups</Title>
    <Description>Shows custom user groups (colour, short name, name, playmodes) on profiles and user cards,
      appended to real osu! groups, with per-user overrides and a public rule API.</Description>
    <Version>1.0.0</Version>
    <IconGlyph>Users</IconGlyph>
    <RepositoryUrl>https://github.com/RuJect/osu-cc</RepositoryUrl>
    <PackageTags>profile;visual;fun;library</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Author Include="rus07tam" OsuProfileId="33701908" />
  </ItemGroup>

  <ItemGroup>
    <PluginDependency Include="username-visuals" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="osucc.Api" />
    <PackageReference Include="osucc.Build" PrivateAssets="all" />
    <PackageReference Include="ppy.osu.Game" />
    <!-- Contract assembly of the built-in UsernameVisuals plugin, consumed for the optional
         username-colour rule (host.GetApi<IUsernameVisualsApi>). Not packed into the plugin
         archive: at runtime it resolves to the already-loaded plugin assembly. -->
    <ProjectReference Include="..\UsernameVisuals\UsernameVisuals.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localisation/*.json" />
  </ItemGroup>

</Project>
