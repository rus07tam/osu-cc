<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OsuCcUpdater</AssemblyName>
    <RootNamespace>OsuCcUpdater</RootNamespace>
    <IsPlugin>true</IsPlugin>
    <PackageId>osucc-updater</PackageId>
    <Title>Updater</Title>
    <Description>Checks the official osu-cc repository for a new build (a GitHub release
      bundle or a local dotnet build) and stages it; the osucc launcher applies the staged update on
      the next launch.</Description>
    <Version>1.0.1</Version>
    <IconGlyph>CloudDownloadAlt</IconGlyph>
    <RepositoryUrl>https://github.com/RuJect/osu-cc</RepositoryUrl>
    <PackageTags>updater;system;library</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Author Include="rus07tam" OsuProfileId="33701908" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="osucc.Api" />
    <PackageReference Include="osucc.Build" PrivateAssets="all" />
    <PackageReference Include="ppy.osu.Game" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localisation/*.json" />
  </ItemGroup>

</Project>
