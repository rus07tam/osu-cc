<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Adds the repo-local NuGet feed (artifacts/nuget) that osucc build fills by packing
    osucc.Host and osucc.Build, so the monorepo plugins dogfood the exact packages external
    plugin repos consume. nuget.org is not cleared here: the artifacts/* sub-repos rely on
    whatever sources the machine config provides.
  -->
  <packageSources>
    <add key="osu-cc-local" value="artifacts/nuget" />
  </packageSources>
</configuration>
