<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>osucc</AssemblyName>
    <RootNamespace>osucc</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PackageId>osucc.Host</PackageId>
    <Version>$(OsuCcHostVersion)</Version>
    <Authors>osu-cc</Authors>
    <Description>Host API and startup-hook assembly for osu-cc: the plugin-facing surface (IOsuCcPlugin, IOsuCcPluginHost, ...) plugins compile against. The runtime hook is this same assembly loaded by the game.</Description>
    <PackageTags>osu osucc plugin host</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" />
    <PackageReference Include="ppy.osu.Game" />
    <PackageReference Include="SharpCompress" />
    <ProjectReference Include="..\osucc.Shared\osucc.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localisation/*.json" />
    <Content Include="Themes\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>