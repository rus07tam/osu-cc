{
  "Id": "Grayscale",
  "Name": "Grayscale",
  "Description": "Full monochrome look: every chrome input is rebuilt as a neutral grey ramp.",
  "AccentTransform": { "Kind": "Desaturate" },
  "Chrome": {
    "TextLightnessThreshold": 0.9,
    "AccentSaturationThreshold": 0.4,
    "Text": { "HueDegrees": 0, "Saturation": 0, "Lightness": 0.95 },
    "Accent": {
      "HueDegrees": 0,
      "Saturation": "Fixed",
      "FixedSaturation": 0,
      "LightnessMin": 0.3,
      "LightnessMax": 0.85
    },
    "Surface": {
      "HueDegrees": 0,
      "Saturation": "Fixed",
      "FixedSaturation": 0,
      "Lightness": {
        "Interpolation": "Linear",
        "ControlPoints": [
          { "X": 0, "Y": 0 },
          { "X": 1, "Y": 1 }
        ]
      }
    }
  }
}
