<Project>

  <!--
    Shared build logic for osu-cc plugin projects, shipped in the osucc.Build NuGet package.
    Projects opt in by setting <IsPlugin>true</IsPlugin>.

    Plugin metadata is declared in the project file (PluginId, PluginName, PluginAuthor,
    PluginDescription, PluginVersion, PluginPriority, PluginIcon, PluginIconGlyph,
    PluginIconResource, PluginRepository, the PluginDependency and PluginTag items) and turned
    into an assembly-level [OsuCcPlugin] attribute by GeneratePluginManifest, so plugin sources
    never write the attribute directly. PluginAuthor is a list of items, each a plain nickname or,
    with the optional OsuProfileId metadata, an osu! profile-linked username (rendered
    clickable by the UI). PluginTag items become the plugin's display tags (chips in
    the plugins UI / search). PluginRepository is the URL of the repository the plugin is
    published from (consumed by the plugin store). PackagePluginArchive packs the plugin's own
    dll (+ optional icon) into <PluginId>.zip under the output directory.
  -->

  <PropertyGroup Condition="'$(IsPlugin)' == 'true'">
    <!-- Only the plugin's own dll is deployed; osu.* / osucc / 0Harmony resolve from the host. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Defaults for the metadata declared in the project file. -->
    <PluginId Condition="'$(PluginId)' == ''">$(AssemblyName)</PluginId>
    <PluginName Condition="'$(PluginName)' == ''">$(PluginId)</PluginName>
    <PluginVersion Condition="'$(PluginVersion)' == ''">$(Version)</PluginVersion>
    <PluginPriority Condition="'$(PluginPriority)' == ''">0</PluginPriority>
  </PropertyGroup>

  <UsingTask TaskName="GeneratePluginManifest" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <OutputFile ParameterType="System.String" Required="true" />
      <Id ParameterType="System.String" Required="true" />
      <Name ParameterType="System.String" Required="true" />
      <Authors ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <Tags ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <Description ParameterType="System.String" />
      <Version ParameterType="System.String" />
      <Priority ParameterType="System.String" />
      <ApiVersion ParameterType="System.String" />
      <IconPath ParameterType="System.String" />
      <Icon ParameterType="System.String" />
      <IconResource ParameterType="System.String" />
      <Repository ParameterType="System.String" />
      <Dependencies ParameterType="System.String[]" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
        #nullable enable
        using System;
        using System.Collections.Generic;
        using System.IO;
        using Microsoft.Build.Framework;
        using Microsoft.Build.Utilities;

        public class GeneratePluginManifest : Task
        {
            public string OutputFile { get; set; } = string.Empty;
            public string Id { get; set; } = string.Empty;
            public string Name { get; set; } = string.Empty;
            public Microsoft.Build.Framework.ITaskItem[]? Authors { get; set; }
            public Microsoft.Build.Framework.ITaskItem[]? Tags { get; set; }
            public string? Description { get; set; }
            public string? Version { get; set; }
            public string? Priority { get; set; }
            public string? ApiVersion { get; set; }
            public string? IconPath { get; set; }
            public string? Icon { get; set; }
            public string? IconResource { get; set; }
            public string? Repository { get; set; }
            public string[]? Dependencies { get; set; }

            public override bool Execute()
            {
                if (string.IsNullOrWhiteSpace(Id))
                {
                    Log.LogError("Plugin metadata is missing: set <PluginId> in the project file (it defaults to the assembly name, which is empty here).");
                    return false;
                }

                if (string.IsNullOrWhiteSpace(Name))
                {
                    Log.LogError("Plugin metadata is missing: set <PluginName> in the project file.");
                    return false;
                }

                if (Priority != null && !int.TryParse(Priority, out _))
                {
                    Log.LogError($"<PluginPriority> must be an integer, got '{Priority}'.");
                    return false;
                }

                if (ApiVersion != null && !int.TryParse(ApiVersion, out _))
                {
                    Log.LogError($"<PluginApiVersion> must be an integer, got '{ApiVersion}'.");
                    return false;
                }

                try
                {
                    File.WriteAllText(OutputFile, BuildSource(), new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
                }
                catch (Exception ex)
                {
                    Log.LogError($"Failed to write plugin manifest '{OutputFile}': {ex.Message}");
                    return false;
                }

                Log.LogMessage(MessageImportance.Low, $"Generated plugin manifest '{OutputFile}' for '{Id}'.");
                return true;
            }

            private string BuildSource()
            {
                var lines = new List<string>
                {
                    "// <auto-generated> Generated from the plugin project file by osucc.Build. Do not edit.</auto-generated>",
                    "#nullable enable",
                    "using osucc.Plugin;",
                    string.Empty,
                };

                var args = new List<string> { Quote(Id), Quote(Name) };

                if (int.TryParse(Priority, out int priority))
                    args.Add(priority.ToString());

                if (int.TryParse(ApiVersion, out int apiVersion))
                {
                    if (!int.TryParse(Priority, out _))
                        args.Add("0");

                    args.Add(apiVersion.ToString());
                }

                var named = new List<string>();

                if (Authors is { Length: > 0 })
                {
                    var authorNames = new string[Authors.Length];
                    var authorIds = new int[Authors.Length];

                    for (int i = 0; i < Authors.Length; i++)
                    {
                        Microsoft.Build.Framework.ITaskItem item = Authors[i];
                        authorNames[i] = item.ItemSpec;

                        if (int.TryParse(item.GetMetadata("OsuProfileId"), out int profileId) && profileId > 0)
                            authorIds[i] = profileId;
                        else
                            authorIds[i] = -1;
                    }

                    named.Add($"AuthorNames = new[] {{ {string.Join(", ", Array.ConvertAll(authorNames, Quote))} }}");
                    named.Add($"AuthorOsuIds = new[] {{ {string.Join(", ", Array.ConvertAll(authorIds, id => id.ToString()))} }}");
                }

                if (Tags is { Length: > 0 })
                {
                    var tags = new List<string>();

                    foreach (Microsoft.Build.Framework.ITaskItem item in Tags)
                    {
                        if (!string.IsNullOrWhiteSpace(item.ItemSpec) && !tags.Contains(item.ItemSpec))
                            tags.Add(item.ItemSpec);
                    }

                    if (tags.Count > 0)
                        named.Add($"Tags = new[] {{ {string.Join(", ", Array.ConvertAll(tags.ToArray(), Quote))} }}");
                }

                if (!string.IsNullOrWhiteSpace(Description))
                    named.Add($"Description = {Quote(Description)}");

                if (!string.IsNullOrWhiteSpace(Version))
                    named.Add($"Version = {Quote(Version)}");

                if (!string.IsNullOrWhiteSpace(IconPath))
                    named.Add($"IconPath = {Quote(IconPath?.Replace('\\', '/'))}");

                if (!string.IsNullOrWhiteSpace(Icon))
                    named.Add($"Icon = {Quote(Icon)}");

                if (!string.IsNullOrWhiteSpace(IconResource))
                    named.Add($"IconResource = {Quote(IconResource)}");

                if (!string.IsNullOrWhiteSpace(Repository))
                    named.Add($"Repository = {Quote(Repository)}");

                if (Dependencies is { Length: > 0 })
                    named.Add($"DependsOn = new[] {{ {string.Join(", ", Array.ConvertAll(Dependencies!, Quote))} }}");

                string declaration = "[assembly: OsuCcPlugin(" + string.Join(", ", args)
                    + (named.Count > 0 ? ", " + string.Join(", ", named) : string.Empty)
                    + ")]";

                lines.Add(declaration);
                lines.Add(string.Empty);
                return string.Join(Environment.NewLine, lines);
            }

            private static string Quote(string? value)
            {
                if (value == null)
                    return "\"\"";

                return "\"" + value.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\r", "\\r").Replace("\n", "\\n").Replace("\t", "\\t") + "\"";
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GeneratePluginManifest" BeforeTargets="CoreCompile" Condition="'$(IsPlugin)' == 'true'">
    <PropertyGroup>
      <_ManifestFile>$(IntermediateOutputPath)PluginMetadata.g.cs</_ManifestFile>
      <!-- The declared image icon is copied into the output preserving its relative path, so the
           manifest's IconPath (e.g. "Assets/icon.webp") resolves inside the plugin folder after
           the archive is extracted. -->
      <_IconOutput>$(OutDir)$(PluginIcon)</_IconOutput>
    </PropertyGroup>

    <Error Condition="'$(PluginIcon)' != '' and !Exists('$(PluginIcon)')" Text="Plugin icon file '$(PluginIcon)' does not exist. Fix &lt;PluginIcon&gt; in the project file." />

    <!-- Authors are the PluginAuthor items (each a nickname or, with OsuProfileId metadata, an osu!
         profile link). -->
    <ItemGroup>
      <_PluginAuthors Include="@(PluginAuthor)" Condition="'@(PluginAuthor)' != ''" />
      <_PluginTags Include="@(PluginTag)" Condition="'@(PluginTag)' != ''" />
    </ItemGroup>

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_IconOutput)'))" Condition="'$(PluginIcon)' != '' and Exists('$(PluginIcon)')" />
    <Copy SourceFiles="$(PluginIcon)" DestinationFiles="$(_IconOutput)" Condition="'$(PluginIcon)' != '' and Exists('$(PluginIcon)')" SkipUnchangedFiles="true" />

    <GeneratePluginManifest
        OutputFile="$(_ManifestFile)"
        Id="$(PluginId)"
        Name="$(PluginName)"
        Authors="@(_PluginAuthors)"
        Tags="@(_PluginTags)"
        Description="$(PluginDescription)"
        Version="$(PluginVersion)"
        Priority="$(PluginPriority)"
        ApiVersion="$(PluginApiVersion)"
        IconPath="$(PluginIcon)"
        Icon="$(PluginIconGlyph)"
        IconResource="$(PluginIconResource)"
        Repository="$(PluginRepository)"
        Dependencies="@(PluginDependency)" />

    <ItemGroup>
      <Compile Include="$(_ManifestFile)" />
    </ItemGroup>
  </Target>

  <Target Name="PackagePluginArchive" AfterTargets="Build" Condition="'$(IsPlugin)' == 'true'">
    <PropertyGroup>
      <_Staging>$(BaseOutputPath)package\$(Configuration)</_Staging>
      <_Archive>$(OutDir)$(PluginId).zip</_Archive>
      <_IconOutput>$(OutDir)$(PluginIcon)</_IconOutput>
    </PropertyGroup>

    <ItemGroup>
      <_PackageFiles Include="$(OutDir)$(AssemblyName).dll" />
      <_PackageFiles Include="$(_IconOutput)" Condition="'$(PluginIcon)' != '' and Exists('$(_IconOutput)')" />
    </ItemGroup>

    <MakeDir Directories="$(_Staging)" />
    <Copy SourceFiles="@(_PackageFiles)" DestinationFolder="$(_Staging)" />
    <ZipDirectory SourceDirectory="$(_Staging)" DestinationFile="$(_Archive)" Overwrite="True" />
    <RemoveDir Directories="$(_Staging)" />
  </Target>

</Project>
