<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPlugin>true</IsPlugin>
    <PackageId>my-plugin</PackageId>
    <Title>My Plugin</Title>
    <Description>An osu-cc plugin generated by dotnet new osucc-plugin.</Description>
    <Version>1.0.0</Version>
    <Priority>100</Priority>
    <PackageTags>example;dev</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Author Include="you" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="osucc.Api" Version="OSUCC_HOST_VERSION" />
    <PackageReference Include="osucc.Build" Version="OSUCC_BUILD_VERSION" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="ppy.osu.Game" Version="2026.702.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localisation/*.json" />
  </ItemGroup>

</Project>
