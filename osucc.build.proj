<Project DefaultTargets="Build">

  <Import Project="$(MSBuildThisFileDirectory)Directory.Packages.props" />

  <PropertyGroup>
    <OsuCcRoot>$(MSBuildThisFileDirectory)</OsuCcRoot>
    <LocalFeed>$(OsuCcRoot)artifacts/nuget</LocalFeed>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
  </PropertyGroup>

  <ItemGroup>
    <PackageProject Include="$(OsuCcRoot)osucc.Shared/osucc.Shared.csproj" />
    <PackageProject Include="$(OsuCcRoot)osucc.Host/osucc.Host.csproj" />
    <PackageProject Include="$(OsuCcRoot)osucc.Api/osucc.Api.csproj" />
    <PackageProject Include="$(OsuCcRoot)build/osucc.Build/osucc.Build.csproj" />
    <PackageProject Include="$(OsuCcRoot)templates/osucc.Templates/osucc.Templates.csproj" />

    <PluginProject Include="$(OsuCcRoot)plugins/*/*.csproj" />
    <BuildProject Include="$(OsuCcRoot)osucc.Host/osucc.Host.csproj" />
    <BuildProject Include="@(PluginProject)" />
  </ItemGroup>

  <Target Name="PackPackages">
    <Message
      Text="Packing osucc.Host / osucc.Build / osucc (tool) / osucc.Templates into $(LocalFeed)..."
      Importance="high" />
    <MakeDir Directories="$(LocalFeed)" />
    <MSBuild Projects="@(PackageProject)" Targets="Restore;Pack"
      Properties="Configuration=$(Configuration);PackageOutputPath=$(LocalFeed)" />
  </Target>

  <Target Name="ClearPackageCache">
    <PropertyGroup>
      <_NuGetPackages>$([System.Environment]::GetEnvironmentVariable('NUGET_PACKAGES'))</_NuGetPackages>
      <_NuGetPackages
        Condition="'$(_NuGetPackages)' == '' and '$([System.OperatingSystem]::IsWindows())' == 'true'">
        $([System.Environment]::GetEnvironmentVariable('USERPROFILE'))\.nuget\packages</_NuGetPackages>
      <_NuGetPackages Condition="'$(_NuGetPackages)' == ''">
        $([System.Environment]::GetEnvironmentVariable('HOME'))/.nuget/packages</_NuGetPackages>
    </PropertyGroup>
    <Message Text="Clearing stale cache: $(_NuGetPackages)/osucc.{host,build}" Importance="low" />
    <RemoveDir Directories="$(_NuGetPackages)/osucc.host"
      Condition="Exists('$(_NuGetPackages)/osucc.host')" />
    <RemoveDir Directories="$(_NuGetPackages)/osucc.api"
      Condition="Exists('$(_NuGetPackages)/osucc.api')" />
    <RemoveDir Directories="$(_NuGetPackages)/osucc.build"
      Condition="Exists('$(_NuGetPackages)/osucc.build')" />
  </Target>

  <Target Name="RestoreAll">
    <MSBuild Projects="@(BuildProject)" Targets="Restore" BuildInParallel="true"
      Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="Build" DependsOnTargets="PackPackages;ClearPackageCache;RestoreAll">
    <Error Condition="'@(PluginProject)' == ''"
      Text="No plugin projects found under $(OsuCcRoot)plugins/." />
    <Message Text="Building hook + @(PluginProject->'%(Filename)', ', ') ($(Configuration))..."
      Importance="high" />
    <MSBuild Projects="@(BuildProject)" BuildInParallel="true"
      Properties="Configuration=$(Configuration);OsuCcPluginBuildSession=1" />
  </Target>

  <Target Name="PackRuntimeBundle" DependsOnTargets="Build">
    <PropertyGroup>
      <RuntimeStaging>$(OsuCcRoot)artifacts/runtime/staging</RuntimeStaging>
      <RuntimeArchive>$(OsuCcRoot)artifacts/runtime/runtime-$(OsuCcHostVersion).zip</RuntimeArchive>
      <HookOutput>$(OsuCcRoot)osucc.Host/bin/$(Configuration)/net8.0</HookOutput>
    </PropertyGroup>

    <ItemGroup>
      <_HookPayload Include="$(HookOutput)/osucc.dll" />
      <_HookPayload Include="$(HookOutput)/osucc.Api.dll" />
      <_HookPayload Include="$(HookOutput)/0Harmony.dll" />
      <_HookPayload Include="$(HookOutput)/SharpCompress.dll" />
      <_HookPayload Include="$(HookOutput)/osucc.Shared.dll" />
      <_ThemeDefinition Include="$(HookOutput)/Themes/*.json" />
    </ItemGroup>

    <RemoveDir Directories="$(RuntimeStaging)" />
    <MakeDir Directories="$(RuntimeStaging)/hook;$(RuntimeStaging)/data/core/Themes" />
    <Copy SourceFiles="@(_HookPayload)" DestinationFolder="$(RuntimeStaging)/hook" />
    <Copy SourceFiles="@(_ThemeDefinition)" DestinationFolder="$(RuntimeStaging)/data/core/Themes" />
    <ZipDirectory SourceDirectory="$(RuntimeStaging)" DestinationFile="$(RuntimeArchive)"
      Overwrite="true" />
    <RemoveDir Directories="$(RuntimeStaging)" />
    <Message Text="Runtime bundle: $(RuntimeArchive)" Importance="high" />
  </Target>

  <Target Name="PackBootstrapBundle" DependsOnTargets="PackRuntimeBundle">
    <PropertyGroup>
      <BootstrapStaging>$(OsuCcRoot)artifacts/bootstrap/staging</BootstrapStaging>
      <BootstrapArchive>$(OsuCcRoot)artifacts/bootstrap/bootstrap-$(OsuCcHostVersion).zip</BootstrapArchive>
      <HookOutput>$(OsuCcRoot)osucc.Host/bin/$(Configuration)/net8.0</HookOutput>
    </PropertyGroup>

    <ItemGroup>
      <_HookPayload Include="$(HookOutput)/osucc.dll" />
      <_HookPayload Include="$(HookOutput)/osucc.Api.dll" />
      <_HookPayload Include="$(HookOutput)/0Harmony.dll" />
      <_HookPayload Include="$(HookOutput)/SharpCompress.dll" />
      <_HookPayload Include="$(HookOutput)/osucc.Shared.dll" />
      <_PluginArchive Include="$(OsuCcRoot)plugins/*/bin/$(Configuration)/net8.0/plugin-*.zip"
                      Exclude="$(OsuCcRoot)plugins/OsuCcUpdater/**" />
      <_ThemeDefinition Include="$(HookOutput)/Themes/*.json" />
    </ItemGroup>

    <RemoveDir Directories="$(BootstrapStaging)" />
    <MakeDir
      Directories="$(BootstrapStaging)/hook;$(BootstrapStaging)/plugins;$(BootstrapStaging)/data/core/Themes" />
    <Copy SourceFiles="@(_HookPayload)" DestinationFolder="$(BootstrapStaging)/hook" />
    <Copy SourceFiles="@(_PluginArchive)" DestinationFolder="$(BootstrapStaging)/plugins" />
    <Copy SourceFiles="@(_ThemeDefinition)" DestinationFolder="$(BootstrapStaging)/data/core/Themes" />
    <ZipDirectory SourceDirectory="$(BootstrapStaging)" DestinationFile="$(BootstrapArchive)"
      Overwrite="true" />
    <RemoveDir Directories="$(BootstrapStaging)" />
    <Message Text="Bootstrap bundle: $(BootstrapArchive)" Importance="high" />
  </Target>

  <Target Name="DeployLocal" DependsOnTargets="Build">
    <PropertyGroup>
      <_GameDataDir Condition="'$(_GameDataDir)' == '' and '$([System.OperatingSystem]::IsLinux())' == 'true'">$([System.Environment]::GetEnvironmentVariable('HOME'))/.local/share/osu/osu-cc</_GameDataDir>
      <_GameDataDir Condition="'$(_GameDataDir)' == '' and '$([System.OperatingSystem]::IsWindows())' == 'true'">$([System.Environment]::GetEnvironmentVariable('APPDATA'))/osu/osu-cc</_GameDataDir>
      <_GameDataDir Condition="'$(_GameDataDir)' == '' and '$([System.OperatingSystem]::IsMacOS())' == 'true'">$([System.Environment]::GetEnvironmentVariable('HOME'))/Library/Application Support/osu/osu-cc</_GameDataDir>
      <HookOutput>$(OsuCcRoot)osucc.Host/bin/$(Configuration)/net8.0</HookOutput>
    </PropertyGroup>
    <ItemGroup>
      <_DeployHook Include="$(HookOutput)/osucc*.dll" />
      <_DeployHook Include="$(HookOutput)/0Harmony.dll" />
      <_DeployHook Include="$(HookOutput)/SharpCompress.dll" />
      <_DeployPlugins Include="$(OsuCcRoot)plugins/**/bin/$(Configuration)/net8.0/*.zip" />
      <_DeployThemes Include="$(HookOutput)/Themes/*.json" />
    </ItemGroup>
    <Message Text="Deploying hook and plugins to $(_GameDataDir)..." Importance="high" />
    <Copy SourceFiles="@(_DeployHook)" DestinationFolder="$(_GameDataDir)/hook" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_DeployPlugins)" DestinationFolder="$(_GameDataDir)/plugins" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_DeployThemes)" DestinationFolder="$(_GameDataDir)/data/core/Themes" SkipUnchangedFiles="false" />
    <Message Text="Deploy completed successfully." Importance="high" />
  </Target>

</Project>
