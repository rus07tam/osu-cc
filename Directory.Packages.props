<Project>

  <!--
    Central Package Management: every PackageReference in the repo (host, launcher, plugins)
    resolves its version from here, so versions stay reproducible. There is no single "osucc
    version" that every component shares: each distributable component versions independently,
    so a change confined to one of them bumps and republishes only that component (see CI).

    The per-component properties below feed both the component's own csproj <Version> and the
    PackageVersion pins for the plugin-facing osucc.Host / osucc.Build packages, so plugins always
    build against whatever is currently packed into the local feed (they reference these two with
    no explicit version). Bump the relevant property to release a new version of that component.
  -->

  <PropertyGroup>
    <OsuCcHostVersion>2.2.0</OsuCcHostVersion>
    <OsuCcBuildVersion>2.2.0</OsuCcBuildVersion>
    <OsuCcSharedVersion>2.0.2</OsuCcSharedVersion>
    <OsuCcLauncherVersion>2.2.0</OsuCcLauncherVersion>
    <OsuCcTemplatesVersion>2.0.3</OsuCcTemplatesVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="osucc.Host" Version="$(OsuCcHostVersion)" />
    <PackageVersion Include="osucc.Build" Version="$(OsuCcBuildVersion)" />
    <PackageVersion Include="Lib.Harmony" Version="2.4.2" />
    <PackageVersion Include="ppy.osu.Game" Version="2026.702.1" />
    <PackageVersion Include="SharpCompress" Version="0.49.1" />
    <PackageVersion Include="DotMake.CommandLine" Version="3.5.0" />
  </ItemGroup>

</Project>
